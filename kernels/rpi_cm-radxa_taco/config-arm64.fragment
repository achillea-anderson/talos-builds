# Changes to Talos's arm64 kernel config (siderolabs/pkgs kernel/build/config-arm64), applied
# by build.sh before the kernel is built. One `CONFIG_NAME=value` per line; each must replace
# an existing line for that option (set, or "# CONFIG_NAME is not set"), so a renamed or
# removed option stops the build instead of being added blindly. Why each: kernels/rpi_cm-radxa_taco/README.md.

# The Radxa TACO's real-time clock: a PCF8563-compatible chip at 0x51 on GPIO 2/3
# (kernels/rpi_cm-radxa_taco/README.md). Raspberry Pi's `i2c-rtc-gpio,pcf8563` overlay asks for this driver.
CONFIG_RTC_DRV_PCF8563=y

# Software ("bit-banged") I2C over plain GPIO, for that clock: under Talos the RP1's hardware
# I2C controller on GPIO 2/3 gets no acknowledgement from any device (kernels/rpi_cm-radxa_taco/README.md),
# while the same chip works over software I2C. Used by `i2c-rtc-gpio` in overlay-<board>.yaml.
CONFIG_I2C_GPIO=y
