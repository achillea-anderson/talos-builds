# What build.sh builds. Change these, and only these, for a new Talos release
# (building.md, "A new Talos release").

# The name of this image family: the kernel it builds (kernels/$NAME/ at the repository's
# root) and the namespace its images are published under ($REGISTRY/$USERNAME/$NAME/).
NAME=rpi_cm-radxa_taco

# The Talos release to build for.
TALOS_VERSION=v1.14.2
# The siderolabs/pkgs commit that release was built from: `PKGS ?= ...` in the Makefile of
# siderolabs/talos at TALOS_VERSION (v1.14.0-37-g6c312e4 is pkgs commit 6c312e4). That
# commit fixes the kernel version (6.18.54) and its config.
PKGS_VERSION=v1.14.0-37-g6c312e4
# The build of the installers: bump for any change (patches, config fragment, overlay
# options) within the same Talos release (b2, b3, ...), back to b1 for a new release. It
# names the installers only; the kernel, installer-base and imager are named after a hash of
# what goes into the kernel (build.sh), so a change that leaves the kernel alone does not
# rebuild it.
BUILD=b8

# The boards to build an installer for, by board ID (boards.md): each needs
# boards/<board>/overlay-options.yaml. installer-<board>:<release>-<BUILD>.
BOARDS="cm5-taco13 cm4-taco13"

# Images no longer built (a renamed or dropped board), deleted entirely by build.sh's
# cleanup.
RETIRED_IMAGES=""

# Where the images go: $REGISTRY/$USERNAME/$NAME/<image>:<tag>. The defaults are this
# repository's published images; to build your own, set both in the environment, e.g.
# REGISTRY=ghcr.io USERNAME=<your account> images/rpi_cm-radxa_taco/build.sh (building.md).
REGISTRY=${REGISTRY:-ghcr.io}
USERNAME=${USERNAME:-achillea-anderson}
